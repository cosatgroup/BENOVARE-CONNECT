DATABASE_URL="postgresql://user:password@localhost:5432/benovare_connect"
JWT_SECRET="change-me-in-production"
# Généré avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY="change-me-32-bytes-base64"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NODE_ENV="development"
RESEND_API_KEY="re_xxx"
OTP_EMAIL_FROM="Benovare Connect <onboarding@resend.dev>"
VEILLE_CRON_SECRET="change-me"

# Abonnements et tarification — paiement KKiaPay
KKIAPAY_PUBLIC_KEY="pk_xxx"
KKIAPAY_PRIVATE_KEY="pk_priv_xxx"
KKIAPAY_SECRET_KEY="sk_xxx"
KKIAPAY_SANDBOX="true"

# Abonnements et tarification — paiement FedaPay
FEDAPAY_SECRET_KEY="sk_sandbox_xxx"
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_WEBHOOK_SECRET="whsec_xxx"

# Abonnements et tarification — virement bancaire (texte affiché au client)
BANK_TRANSFER_INSTRUCTIONS="Contactez Benovare pour obtenir le RIB et la référence de virement."
